diff --git a/Dockerfile.pusher b/Dockerfile.pusher
new file mode 100644
index 0000000..3c4914e
--- /dev/null
+++ b/Dockerfile.pusher
@@ -0,0 +1,11 @@
+# 슬랙 푸셔 전용 가벼운 이미지. 플레이 라이트와 크로미움을 넣지 않는다.
+FROM python:3.11-slim
+ENV PYTHONDONTWRITEBYTECODE=1
+ENV PYTHONUNBUFFERED=1
+ENV TZ=Asia/Seoul
+WORKDIR /app
+RUN apt-get update && apt-get install -y --no-install-recommends tzdata && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && rm -rf /var/lib/apt/lists/*
+COPY requirements-pusher.txt .
+RUN pip install --no-cache-dir -r requirements-pusher.txt
+COPY slack_pusher.py .
+CMD ["python", "-u", "slack_pusher.py"]
